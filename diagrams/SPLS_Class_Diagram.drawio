  <diagram id="domain-model" name="Domain Model">
    <mxGraphModel dx="1920" dy="1690" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1690" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="domain-title" value="&lt;b&gt;Smart Parking Lot — Domain Model&lt;/b&gt;&lt;br/&gt;Core model classes and their relationships" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1840" height="55" as="geometry" />
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;&lt;i&gt;«abstract» User&lt;/i&gt;&lt;/b&gt;&lt;hr align='left'/&gt;- id: String&lt;br/&gt;- name: String&lt;br/&gt;- contact: String&lt;br/&gt;&lt;br/&gt;# User(id, name, contact)&lt;br/&gt;+ getId(): String&lt;br/&gt;+ getName(): String&lt;br/&gt;+ getContact(): String" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="95" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="driver" value="&lt;b&gt;Driver&lt;/b&gt;&lt;hr align='left'/&gt;- vehicles: List&amp;lt;Vehicle&amp;gt;&lt;br/&gt;&lt;br/&gt;+ Driver(id, name, contact)&lt;br/&gt;+ getVehicles(): List&amp;lt;Vehicle&amp;gt;&lt;br/&gt;+ addVehicle(vehicle): void&lt;br/&gt;+ removeVehicle(vehicle): boolean" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="90" y="355" width="440" height="210" as="geometry" />
        </mxCell>
        <mxCell id="administrator" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;hr align='left'/&gt;- role: String&lt;br/&gt;&lt;br/&gt;+ Administrator(id, name, contact, role)&lt;br/&gt;+ getRole(): String&lt;br/&gt;+ resolveIncident(incident, note): void&lt;br/&gt;+ updateSpace(space, status): void" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="355" width="440" height="210" as="geometry" />
        </mxCell>
        <mxCell id="attendant" value="&lt;b&gt;Attendant&lt;/b&gt;&lt;hr align='left'/&gt;- assignedSessions: List&amp;lt;ParkingSession&amp;gt;&lt;br/&gt;- parkingService: ParkingService&lt;br/&gt;&lt;br/&gt;+ Attendant(id, name, contact, parkingService)&lt;br/&gt;+ getAssignedSessions(): List&lt;br/&gt;+ getParkingService(): ParkingService&lt;br/&gt;+ recordEntry(vehicle): ParkingSession&lt;br/&gt;+ recordExit(session): void&lt;br/&gt;+ assistDriver(driver): void" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1390" y="355" width="470" height="250" as="geometry" />
        </mxCell>
        <mxCell id="vehicle" value="&lt;b&gt;Vehicle&lt;/b&gt;&lt;hr align='left'/&gt;- plate: String&lt;br/&gt;- type: VehicleType&lt;br/&gt;&lt;br/&gt;+ Vehicle(plate, type)&lt;br/&gt;+ getPlate(): String&lt;br/&gt;+ getType(): VehicleType&lt;br/&gt;+ isCompatible(space): boolean" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="parking-lot" value="&lt;b&gt;ParkingLot&lt;/b&gt;&lt;hr align='left'/&gt;- name: String&lt;br/&gt;- spaces: List&amp;lt;ParkingSpace&amp;gt;&lt;br/&gt;&lt;br/&gt;+ ParkingLot(name, spaces)&lt;br/&gt;+ getName(): String&lt;br/&gt;+ getSpaces(): List&lt;br/&gt;+ availableSpaces(type): List&lt;br/&gt;+ assignSpace(vehicle): ParkingSpace&lt;br/&gt;+ getCapacity(): int&lt;br/&gt;+ getOccupiedCount(): long" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="700" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="parking-space" value="&lt;b&gt;ParkingSpace&lt;/b&gt;&lt;hr align='left'/&gt;- id: String&lt;br/&gt;- level: String&lt;br/&gt;- type: SpaceType&lt;br/&gt;- status: SpaceStatus&lt;br/&gt;&lt;br/&gt;+ ParkingSpace(id, level, type[, status])&lt;br/&gt;+ getId(), getLevel(), getType(), getStatus()&lt;br/&gt;+ reserve(): boolean&lt;br/&gt;+ occupy(): boolean&lt;br/&gt;+ release(): void&lt;br/&gt;+ setOutOfService(): void&lt;br/&gt;+ setStatus(status): void" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="980" y="700" width="430" height="280" as="geometry" />
        </mxCell>
        <mxCell id="incident" value="&lt;b&gt;Incident&lt;/b&gt;&lt;hr align='left'/&gt;- id, type, details: String&lt;br/&gt;- space: ParkingSpace&lt;br/&gt;- createdAt: Instant&lt;br/&gt;- status: IncidentStatus&lt;br/&gt;- resolution: String&lt;br/&gt;&lt;br/&gt;+ resolve(note): void" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1450" y="700" width="430" height="250" as="geometry" />
        </mxCell>
        <mxCell id="reservation" value="&lt;b&gt;Reservation&lt;/b&gt;&lt;hr align='left'/&gt;- reference, driverId, plate: String&lt;br/&gt;- vehicleType: VehicleType&lt;br/&gt;- space: ParkingSpace&lt;br/&gt;- arrivalAt, expiresAt: Instant&lt;br/&gt;- status: ReservationStatus&lt;br/&gt;&lt;br/&gt;+ checkIn(): boolean&lt;br/&gt;+ cancel(): void&lt;br/&gt;+ expire(): void&lt;br/&gt;+ expireIfOverdue(now): boolean&lt;br/&gt;+ complete(): void" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="parking-session" value="&lt;b&gt;ParkingSession&lt;/b&gt;&lt;hr align='left'/&gt;- vehicle: Vehicle&lt;br/&gt;- space: ParkingSpace&lt;br/&gt;- startedAt, endedAt: Instant&lt;br/&gt;- reservationReference: String&lt;br/&gt;- status: SessionStatus&lt;br/&gt;- reminderSent: boolean&lt;br/&gt;&lt;br/&gt;+ duration(): Duration&lt;br/&gt;+ markReminderSent(): void&lt;br/&gt;+ close(endTime): boolean" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="1040" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="rate" value="&lt;b&gt;Rate&lt;/b&gt;&lt;hr align='left'/&gt;- vehicleType: VehicleType&lt;br/&gt;- hourlyAmount: BigDecimal&lt;br/&gt;&lt;br/&gt;+ Rate(vehicleType, hourlyAmount)&lt;br/&gt;+ getVehicleType(): VehicleType&lt;br/&gt;+ getHourlyAmount(): BigDecimal&lt;br/&gt;+ calculate(duration): BigDecimal" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="980" y="1040" width="430" height="230" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="&lt;b&gt;Payment&lt;/b&gt;&lt;hr align='left'/&gt;- reference: String&lt;br/&gt;- amount: BigDecimal&lt;br/&gt;- method: PaymentMethod&lt;br/&gt;- status: PaymentStatus&lt;br/&gt;- paidAt: Instant&lt;br/&gt;&lt;br/&gt;+ recordResult(successful, time): void&lt;br/&gt;+ receipt(): String" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1040" width="430" height="240" as="geometry" />
        </mxCell>
        <mxCell id="enum-types" value="&lt;b&gt;Enum types in the repository&lt;/b&gt;&lt;hr align='left'/&gt;&lt;b&gt;VehicleType&lt;/b&gt;: STANDARD, MOTORCYCLE, EV, ACCESSIBLE&lt;br/&gt;&lt;b&gt;SpaceType&lt;/b&gt;: STANDARD, MOTORCYCLE, EV, ACCESSIBLE&lt;br/&gt;&lt;b&gt;SpaceStatus&lt;/b&gt;: AVAILABLE, RESERVED, OCCUPIED, OUT_OF_SERVICE&lt;br/&gt;&lt;b&gt;SessionStatus&lt;/b&gt;: ACTIVE, COMPLETED&lt;br/&gt;&lt;b&gt;ReservationStatus&lt;/b&gt;: RESERVED, CHECKED_IN, COMPLETED, CANCELLED, EXPIRED&lt;br/&gt;&lt;b&gt;IncidentStatus&lt;/b&gt;: OPEN, RESOLVED&lt;br/&gt;&lt;b&gt;PaymentStatus&lt;/b&gt;: PENDING, PAID, FAILED&lt;br/&gt;&lt;b&gt;PaymentMethod&lt;/b&gt;: MAYA, PAYPAL, GCASH, GOMO, CASH, OTHER_E_WALLET" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1360" width="1840" height="280" as="geometry" />
        </mxCell>
        <mxCell id="extends-driver" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;fontSize=11;" edge="1" parent="1" source="driver" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="extends-admin" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;fontSize=11;" edge="1" parent="1" source="administrator" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="extends-attendant" value="extends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;fontSize=11;" edge="1" parent="1" source="attendant" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="driver-vehicle" value="registers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;fontSize=11;" edge="1" parent="1" source="driver" target="vehicle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lot-space" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;fontSize=11;" edge="1" parent="1" source="parking-lot" target="parking-space">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="incident-space" value="may concern" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;fontSize=11;" edge="1" parent="1" source="incident" target="parking-space">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="services-and-entry-points" name="Services &amp; Entry Points">
    <mxGraphModel dx="1920" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="support-title" value="&lt;b&gt;Smart Parking Lot — Services &amp; Entry Points&lt;/b&gt;&lt;br/&gt;Application classes and shared utilities used by the domain model" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1840" height="55" as="geometry" />
        </mxCell>
        <mxCell id="reservation-service" value="&lt;b&gt;ReservationService&lt;/b&gt;&lt;hr align='left'/&gt;- reservations: List&amp;lt;Reservation&amp;gt;&lt;br/&gt;- parkingLot: ParkingLot&lt;br/&gt;- reservationWindow: Duration&lt;br/&gt;&lt;br/&gt;+ reserve(driver, vehicle): Reservation&lt;br/&gt;+ cancel(reservation): void&lt;br/&gt;+ expireOverdue(): void&lt;br/&gt;+ getReservations(), getParkingLot(), getReservationWindow()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="135" width="540" height="280" as="geometry" />
        </mxCell>
        <mxCell id="parking-service" value="&lt;b&gt;ParkingService&lt;/b&gt;&lt;hr align='left'/&gt;- maxSessionHours: int&lt;br/&gt;- parkingLot: ParkingLot&lt;br/&gt;&lt;br/&gt;+ findAvailable(type): List&amp;lt;ParkingSpace&amp;gt;&lt;br/&gt;+ startSession(vehicle): ParkingSession&lt;br/&gt;+ startSession(vehicle, space): ParkingSession&lt;br/&gt;+ endSession(session): void" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="690" y="135" width="540" height="280" as="geometry" />
        </mxCell>
        <mxCell id="payment-service" value="&lt;b&gt;PaymentService&lt;/b&gt;&lt;hr align='left'/&gt;- provider: String&lt;br/&gt;- rates: Map&amp;lt;VehicleType, Rate&amp;gt;&lt;br/&gt;- payments: List&amp;lt;Payment&amp;gt;&lt;br/&gt;- paidSessions: Set&amp;lt;ParkingSession&amp;gt;&lt;br/&gt;&lt;br/&gt;+ process(session, method): Payment&lt;br/&gt;+ issueReceipt(payment): String&lt;br/&gt;+ getProvider(), getRates(), getPayments()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1310" y="135" width="540" height="280" as="geometry" />
        </mxCell>
        <mxCell id="server" value="&lt;b&gt;Server&lt;/b&gt;&lt;hr align='left'/&gt;- ROOT: Path {static}&lt;br/&gt;- SESSIONS: Map&amp;lt;String, Long&amp;gt; {static}&lt;br/&gt;- admin settings, cookie, file types&lt;br/&gt;&lt;br/&gt;+ main(args): void {static}&lt;br/&gt;Serves browser files and handles login/session requests." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="525" width="540" height="245" as="geometry" />
        </mxCell>
        <mxCell id="console-main" value="&lt;b&gt;ConsoleMain&lt;/b&gt;&lt;hr align='left'/&gt;No instance fields; console entry point.&lt;br/&gt;&lt;br/&gt;+ main(args): void {static}&lt;br/&gt;Coordinates one demo parking and payment flow through the service classes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="690" y="525" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="validation" value="&lt;b&gt;Validation&lt;/b&gt;&lt;hr align='left'/&gt;Shared input checks; no instance fields.&lt;br/&gt;&lt;br/&gt;+ requireText(value, name): String {static}&lt;br/&gt;+ requireNonNull(value, name): T {static}&lt;br/&gt;+ requireNotFuture(value, name): Instant {static}&lt;br/&gt;+ requirePositive(value, name): int {static}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1310" y="525" width="540" height="245" as="geometry" />
        </mxCell>
        <mxCell id="compatibility-policy" value="&lt;b&gt;CompatibilityPolicy&lt;/b&gt;&lt;hr align='left'/&gt;Utility class; no instance fields.&lt;br/&gt;&lt;br/&gt;+ isCompatible(vehicle, space): boolean {static}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="690" y="850" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="support-note" value="&lt;b&gt;Diagram notes&lt;/b&gt;&lt;hr align='left'/&gt;• The console flow and browser server are separate entry points.&lt;br/&gt;• The console demo calls ParkingService and PaymentService; Server serves the browser prototype.&lt;br/&gt;• Validation is shared by model classes. CompatibilityPolicy centralizes vehicle/space matching.&lt;br/&gt;• The domain page shows all 19 Java classes and all eight enum types." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="850" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="api-note" value="&lt;b&gt;Reading the diagram&lt;/b&gt;&lt;hr align='left'/&gt;Fields use UML visibility: “-” means private and “#” means protected. The boxes show current fields and selected public methods from the Java source. Details not useful to the class relationships are omitted for readability." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1310" y="850" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="console-parking-service" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;fontSize=11;" edge="1" parent="1" source="console-main" target="parking-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="console-payment-service" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;fontSize=11;" edge="1" parent="1" source="console-main" target="payment-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>