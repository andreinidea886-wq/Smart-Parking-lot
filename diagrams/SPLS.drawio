        <mxCell id="arrive" value="Arrive at parking lot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="585" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="valid" value="Reservation valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="580" y="690" width="200" height="100" as="geometry"/></mxCell>
