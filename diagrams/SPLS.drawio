  <diagram id="spls-flowchart" name="Smart Parking Lot Flowchart">
    <mxGraphModel dx="1200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Smart Parking Lot - Driver Flow (HTML/CSS/JS + Java; no IoT)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="605" y="80" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="check" value="Select vehicle type (car, motorcycle, EV, etc.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="175" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="available" value="Is a compatible space available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="580" y="285" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="wait" value="Wait and refresh compatible-space availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="925" y="300" width="220" height="65" as="geometry"/></mxCell>
