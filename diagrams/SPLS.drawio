        <mxCell id="park" value="Park vehicle; system marks space occupied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="1065" width="270" height="70" as="geometry"/></mxCell>
