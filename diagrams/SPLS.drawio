        <mxCell id="assignOpen" value="Assign an available space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="925" y="845" width="220" height="70" as="geometry"/></mxCell>
